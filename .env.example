# ============================================================================
# AUTHENTIX — Institutional Application & Regulatory Verification
# Copy this file to .env for local customisation. Never commit real secrets.
# ============================================================================

# Application Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Server-Side Demo Mode Flag
# Accepted values: true | false (defaults safely to false when unset).
# When true: enables clearly labeled synthetic demo accounts (*.demo) and synthetic sample fixtures.
# When false: disables demo login shortcuts, credential displays, demo accounts, and synthetic sample data.
ENABLE_DEMO_MODE=false

# Security & Cryptographic Signing
# Leave blank in local development to use ephemeral CSPRNG keys; in NODE_ENV=production provide strong >=32-char random secrets (e.g. openssl rand -hex 32).
SESSION_SECRET=
QR_SIGNING_SECRET=
SESSION_TTL_HOURS=12
CORS_ORIGIN=http://localhost:3000

# Persistent Database Configuration
# Active runtime database engine is SQLite WAL (`node:sqlite` at ./data/authentix.sqlite).
DB_ENGINE=sqlite
SQLITE_DB_PATH=./data/authentix.sqlite
AUTO_SEED_DEMO_DATA=false

# Optional Non-Demo Bootstrap Administrator (used by `npm run db:create-admin` when ENABLE_DEMO_MODE=false)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Administrator

# Optional PostgreSQL Reference Configuration (Inert while DB_ENGINE=sqlite; db/postgres-schema.sql is reference DDL only)
# IMPORTANT: Treat placeholder values for POSTGRES_PASSWORD as development placeholders only — never use placeholders in production.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=authentix
POSTGRES_USER=authentix_app
POSTGRES_PASSWORD=replace-with-strong-db-password

# Document Storage & Upload Limits
UPLOAD_DIR=./data/uploads
SAMPLE_DOCS_DIR=./data/sample_docs
MAX_UPLOAD_MB=15

# Document Processing & Python OCR / Forensics Service
# Port 8001 is standardized across backend, Python OCR service, Docker, and scripts.
OCR_SERVICE_PORT=8001
OCR_SERVICE_URL=http://127.0.0.1:8001
OCR_TIMEOUT_MS=8000
# OCR_MODE options: auto | local-only (safe local demo without external OCR daemon) | unavailable | timeout
OCR_MODE=auto

# Optional Gemini API Key (Injected automatically in AI Studio Secrets if configured; not required for core platform)
GEMINI_API_KEY=MY_GEMINI_API_KEY
